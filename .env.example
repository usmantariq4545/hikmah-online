# Hikmah Online — environment variables. Copy to .env.dev / .env.staging / .env.prod.
# Real env files are git-ignored and live only on the machine that uses them.
# On a laptop, run scripts/init-env.sh to create .env.dev with generated passwords.

# --- Environment ------------------------------------------------------------
COMPOSE_PROJECT_NAME=hikmah          # Compose project; names the volumes. Do not change after install.
SITE_ENV=dev                         # dev | staging | prod
# dev only: set to "developer" while writing code. It makes every request much slower, so leave empty for testing.
MOODLE_DEBUG=
MOODLE_WWWROOT=http://localhost:8080 # Public URL, no trailing slash. https://… on staging/prod.
HTTP_PORT=8080                       # dev only: local port for Nginx
MAILPIT_PORT=8025                    # dev only: local port for the Mailpit inbox
MOODLE_IMAGE=hikmah-moodle:local     # staging/prod: ghcr.io/<owner>/hikmah-moodle:<tag>
NGINX_IMAGE=hikmah-nginx:local       # staging/prod: ghcr.io/<owner>/hikmah-nginx:<tag>
IMAGE_PULL_POLICY=always             # staging/prod: always (registry images) or never (built on the server)
MOODLE_UPGRADE_KEY=                  # staging/prod: protects the web upgrade page

# --- Site and first administrator (used once by scripts/install.sh) ----------
HIKMAH_SITE_NAME=Hikmah Online
HIKMAH_ADMIN_USER=admin
HIKMAH_ADMIN_PASSWORD=               # generated by init-env.sh on dev; set a strong one elsewhere
HIKMAH_ADMIN_EMAIL=admin@example.invalid

# --- Database ---------------------------------------------------------------
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=                         # required

# --- TLS (staging/prod, compose.server.yml) ----------------------------------
SITE_HOST=                           # e.g. staging.example.org (DNS must point at the server). During a domain move a comma list ("new, old"): contabo.md section 11
ACME_EMAIL=                          # Let's Encrypt contact address

# --- Email (transactional SMTP provider; dev uses Mailpit automatically) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=tls                      # tls | ssl | empty
SMTP_NOREPLY=no-reply@example.invalid
STAGING_MAIL_DIVERT=                 # staging: inbox that receives all non-allow-listed mail
STAGING_MAIL_ALLOWLIST=              # staging: comma-separated addresses/regex that get real mail

# --- Google sign-in (AUTH-02). Redirect URI: <MOODLE_WWWROOT>/admin/oauth2callback.php
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# --- Sign-up bot check: Google reCAPTCHA v2 ("I'm not a robot" checkbox) keys for the site domain.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Monitoring heartbeats: Healthchecks.io ping URLs; empty = no heartbeat (docs/runbooks/monitoring.md).
HEALTHCHECK_CRON_URL=                # pinged after every successful cron run (about once a minute)
HEALTHCHECK_BACKUP_URL=              # pinged when the nightly backup.sh finishes

# --- BigBlueButton. Leave empty to use Moodle's free BBB tier (25 users, 60 min).
BBB_SERVER_URL=
BBB_SHARED_SECRET=
# Live classes and recordings open inside a Hikmah page. Set to 0 if the BBB host refuses to be framed.
HIKMAH_EMBED_CLASSROOM=1
# Ask the BBB server to show classes in Hikmah colours with the Hikmah logo (0 to switch off).
HIKMAH_BBB_BRANDING=1
# Students can see classmate lists and message each other (1) or only their teachers (0, default).
HIKMAH_STUDENT_PEERS=0

# --- Transfer accounts shown to learners (paygw_hikmahtransfer) --------------
HIKMAH_BANK_TITLE=
HIKMAH_BANK_NAME=
HIKMAH_BANK_IBAN=
HIKMAH_JAZZCASH=
HIKMAH_EASYPAISA=
HIKMAH_RAAST=
HIKMAH_TRANSFER_NOTE=                 # optional extra line on the payment page (e.g. NTN, what to write as the transfer reference)

# --- Off-host backups (scripts/backup.sh; optional rclone remote) ------------
BACKUP_REMOTE=                       # e.g. s3remote:hikmah-backups (rclone remote:path)
