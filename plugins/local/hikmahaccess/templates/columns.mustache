{{!
    @template local_hikmahaccess/columns

    "Columns" button on the Users page: tick the columns to show, then Apply.

    Example context (json):
    {
        "action": "https://example.com/local/hikmahaccess/users.php",
        "sesskey": "abc",
        "options": [{"key": "email", "name": "Email address", "checked": true}]
    }
}}
<div class="hk-usercolumns dropdown d-flex justify-content-end mb-2">
    <button type="button" class="btn btn-outline-secondary dropdown-toggle" id="hk-usercolumns-toggle"
            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
        {{#str}} columns, local_hikmahaccess {{/str}}
    </button>
    <form class="dropdown-menu dropdown-menu-end p-3" method="post" action="{{action}}"
          aria-labelledby="hk-usercolumns-toggle" style="min-width: 18rem;">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="savecolumns" value="1">
        <fieldset>
            <legend class="fs-6 fw-bold">{{#str}} columnsshow, local_hikmahaccess {{/str}}</legend>
            {{#options}}
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="columns[]" value="{{key}}" id="hk-col-{{key}}"
                       {{#checked}}checked{{/checked}}>
                <label class="form-check-label" for="hk-col-{{key}}">{{name}}</label>
            </div>
            {{/options}}
        </fieldset>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">{{#str}} apply, local_hikmahaccess {{/str}}</button>
            <button type="submit" name="resetcolumns" value="1" class="btn btn-link">{{#str}} columnsreset, local_hikmahaccess {{/str}}</button>
        </div>
    </form>
</div>
