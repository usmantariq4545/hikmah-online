{{!
    @template local_hikmahattendance/needs_activities

    Shown when a course has no BigBlueButton or no Attendance activity to link.

    Example context (json):
    {
        "nobbb": true,
        "noattendance": false,
        "courseurl": "#"
    }
}}
<div class="hk-pay hk-pay--narrow">
    <div class="hk-empty">
        <h3>{{#str}}needs_title, local_hikmahattendance{{/str}}</h3>
        {{#nobbb}}<p>{{#str}}needs_bbb, local_hikmahattendance{{/str}}</p>{{/nobbb}}
        {{#noattendance}}<p>{{#str}}needs_attendance, local_hikmahattendance{{/str}}</p>{{/noattendance}}
        <a class="hk-btn hk-btn--sm" href="{{courseurl}}">{{#str}}needs_gotocourse, local_hikmahattendance{{/str}}</a>
    </div>
</div>
