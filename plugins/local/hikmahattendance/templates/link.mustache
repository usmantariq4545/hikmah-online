{{!
    @template local_hikmahattendance/link

    Link a live class to an attendance session.

    Example context (json):
    {
        "isedit": false,
        "form": "<form></form>",
        "deleteurl": "",
        "sesskey": "abc",
        "backurl": "#"
    }
}}
<div class="hk-pay hk-pay--narrow">
    <p><a href="{{backurl}}">← {{#str}}backtosessions, local_hikmahattendance{{/str}}</a></p>
    <div class="hk-panel" data-hk-reveal>
        <span class="hk-eyebrow">{{#str}}linktitle, local_hikmahattendance{{/str}}</span>
        <p class="text-muted mt-2">{{#str}}link_lead, local_hikmahattendance{{/str}}</p>
        {{{form}}}
    </div>
    {{#isedit}}
        <form method="post" action="{{deleteurl}}" class="text-end">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="delete" value="1">
            <button type="submit" class="hk-btn hk-btn--ghost hk-btn--danger hk-btn--sm">{{#str}}link_delete, local_hikmahattendance{{/str}}</button>
        </form>
    {{/isedit}}
</div>
