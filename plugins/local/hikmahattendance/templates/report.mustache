{{!
    @template local_hikmahattendance/report

    Reconciliation report: evidence beside the final register mark.

    Example context (json):
    {
        "hasrows": true,
        "downloadurl": "#",
        "backurl": "#",
        "rows": [{"session": "13/11/26, 18:00", "learner": "Aisha Khan", "attendedminutes": 52.2, "classminutes": 60, "percent": 86, "threshold": 75, "computed": {"label": "Present", "class": "hk-chip--success"}, "final": {"label": "Present", "class": "hk-chip--success"}, "overridden": false, "reason": "", "register": "Present", "markedby": "Hamza Malik", "state": "Applied", "applied": "13/11/26, 19:30"}]
    }
}}
<div class="hk-pay hk-pay--wide">
    <p><a href="{{backurl}}">← {{#str}}backtosessions, local_hikmahattendance{{/str}}</a></p>
    <div class="hk-queuehead" data-hk-reveal>
        <div>
            <span class="hk-eyebrow">{{#str}}reporttitle, local_hikmahattendance{{/str}}</span>
            <p class="text-muted mb-0">{{#str}}report_lead, local_hikmahattendance{{/str}}</p>
        </div>
        {{#hasrows}}<a class="hk-btn hk-btn--sm" href="{{downloadurl}}">{{#str}}downloadcsv, local_hikmahattendance{{/str}}</a>{{/hasrows}}
    </div>
    {{#hasrows}}
        <div class="hk-panel hk-panel--flush" data-hk-reveal>
            <div class="table-responsive">
                <table class="hk-table">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}}col_session, local_hikmahattendance{{/str}}</th>
                            <th scope="col">{{#str}}col_learner, local_hikmahattendance{{/str}}</th>
                            <th scope="col">{{#str}}col_evidence, local_hikmahattendance{{/str}}</th>
                            <th scope="col">{{#str}}col_computed, local_hikmahattendance{{/str}}</th>
                            <th scope="col">{{#str}}col_final, local_hikmahattendance{{/str}}</th>
                            <th scope="col">{{#str}}col_register, local_hikmahattendance{{/str}}</th>
                            <th scope="col">{{#str}}col_state, local_hikmahattendance{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                <td>{{session}}</td>
                                <td>{{learner}}</td>
                                <td><strong>{{percent}}%</strong> <span class="text-muted small">({{attendedminutes}} / {{classminutes}} min)</span></td>
                                <td><span class="hk-chip {{computed.class}}">{{computed.label}}</span></td>
                                <td>
                                    <span class="hk-chip {{final.class}}">{{final.label}}</span>
                                    {{#overridden}}<div class="small text-muted mt-1">{{reason}}</div>{{/overridden}}
                                </td>
                                <td>{{register}}{{#markedby}}<div class="small text-muted">{{markedby}}</div>{{/markedby}}</td>
                                <td>{{state}}{{#applied}}<div class="small text-muted">{{applied}}</div>{{/applied}}</td>
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        </div>
    {{/hasrows}}
    {{^hasrows}}
        <div class="hk-empty"><h3>{{#str}}nodecisions, local_hikmahattendance{{/str}}</h3></div>
    {{/hasrows}}
</div>
