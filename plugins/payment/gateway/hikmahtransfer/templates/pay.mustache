{{!
    @template paygw_hikmahtransfer/pay

    Transfer instructions, payment reference and the receipt form.

    Example context (json):
    {
        "item": "Foundations of Tajweed",
        "amount": "PKR 4,500.00",
        "reference": "HKM-4-12-A1B2C3",
        "accounts": [{"name": "Bank transfer", "key": "bank", "lines": [{"label": "IBAN", "value": "PK00DEMO"}]}],
        "instructions": "",
        "resubmit": false,
        "remarks": "",
        "error": "",
        "form": "<form></form>"
    }
}}
<div class="hk-pay">
    <div class="hk-pay__intro" data-hk-reveal>
        <span class="hk-eyebrow">{{#str}}pay_eyebrow, paygw_hikmahtransfer{{/str}}</span>
        <h2 class="hk-pay__title">{{{item}}}</h2>
        <p class="text-muted mb-0">{{#str}}pay_lead, paygw_hikmahtransfer{{/str}}</p>
    </div>

    {{#resubmit}}
        <div class="hk-callout hk-callout--sky" role="status">
            <strong>{{#str}}resubmit_title, paygw_hikmahtransfer{{/str}}</strong>
            {{#remarks}}<p class="mb-0 mt-1">{{remarks}}</p>{{/remarks}}
        </div>
    {{/resubmit}}
    {{#error}}
        <div class="hk-callout hk-callout--danger" role="alert"><strong>{{error}}</strong></div>
    {{/error}}

    <div class="hk-pay__grid">
        <section class="hk-panel" data-hk-reveal aria-labelledby="hk-pay-step1">
            <div class="hk-step"><span class="hk-step__num">1</span><h3 id="hk-pay-step1">{{#str}}pay_step1, paygw_hikmahtransfer{{/str}}</h3></div>
            <div class="hk-pay__amount">
                <div>
                    <div class="hk-pay__label">{{#str}}amountdue, paygw_hikmahtransfer{{/str}}</div>
                    <div class="hk-pay__value">{{amount}}</div>
                </div>
                <div>
                    <div class="hk-pay__label">{{#str}}reference, paygw_hikmahtransfer{{/str}}</div>
                    <div class="hk-pay__ref">
                        <code>{{reference}}</code>
                        <button type="button" class="hk-copy" data-hk-copy="{{reference}}" data-hk-copied="{{#str}}copied, paygw_hikmahtransfer{{/str}}">{{#str}}copy, paygw_hikmahtransfer{{/str}}</button>
                    </div>
                </div>
            </div>
            <p class="small text-muted">{{#str}}reference_hint, paygw_hikmahtransfer{{/str}}</p>

            <div class="hk-accounts" data-hk-stagger>
                {{#accounts}}
                    <div class="hk-account hk-account--{{key}}">
                        <div class="hk-account__name">{{name}}</div>
                        <dl class="hk-account__lines">
                            {{#lines}}
                                <div>
                                    <dt>{{label}}</dt>
                                    <dd>
                                        <span>{{value}}</span>
                                        <button type="button" class="hk-copy" data-hk-copy="{{value}}" data-hk-copied="{{#str}}copied, paygw_hikmahtransfer{{/str}}">{{#str}}copy, paygw_hikmahtransfer{{/str}}</button>
                                    </dd>
                                </div>
                            {{/lines}}
                        </dl>
                    </div>
                {{/accounts}}
            </div>
            {{#instructions}}<p class="hk-pay__note">{{instructions}}</p>{{/instructions}}
        </section>

        <section class="hk-panel" data-hk-reveal aria-labelledby="hk-pay-step2">
            <div class="hk-step"><span class="hk-step__num">2</span><h3 id="hk-pay-step2">{{#str}}pay_step2, paygw_hikmahtransfer{{/str}}</h3></div>
            <p class="text-muted">{{#str}}pay_step2_text, paygw_hikmahtransfer{{/str}}</p>
            <div class="hk-pay__form">{{{form}}}</div>
        </section>
    </div>
</div>
