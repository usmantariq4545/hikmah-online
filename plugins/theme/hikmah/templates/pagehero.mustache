{{!
    @template theme_hikmah/pagehero

    The dashboard's banner at the top of the learner's own pages (profile, grades, payments,
    preferences): eyebrow, title, a lead line and a few numbers.

    Example context (json):
    {
        "eyebrow": "Your grades",
        "title": "Grades",
        "lead": "Your course totals so far.",
        "hasstats": true,
        "stats": [{"value": 3, "suffix": "", "label": "Courses"}]
    }
}}
<section class="hk-dash hk-pagehero">
    <div class="hk-dash__hero">
        {{#motif}}{{> theme_hikmah/motif }}{{/motif}}
        <div class="hk-dash__hero-text">
            <span class="hk-eyebrow hk-eyebrow--light">{{eyebrow}}</span>
            <h2 class="hk-dash__title">{{title}}</h2>
            {{#lead}}<p class="hk-pagehero__lead">{{lead}}</p>{{/lead}}
        </div>
        {{#hasstats}}
        <dl class="hk-dash__stats">
            {{#stats}}
                <div>
                    <dd class="hk-dash__num" data-hk-count="{{value}}" data-hk-suffix="{{suffix}}">{{value}}{{suffix}}</dd>
                    <dt>{{label}}</dt>
                </div>
            {{/stats}}
        </dl>
        {{/hasstats}}
    </div>
</section>
