{{!
    @template theme_hikmah/enrol_apply

    Moodle's enrolment page when it is needed: applying for a place (or entering an enrolment key).
    The page heading (the course name) comes from the layout.

    Example context (json):
    {
        "coursename": "Arabic for Beginners",
        "summary": "Start reading, writing and understanding Arabic from the first lesson.",
        "teachers": "Maryam Siddiqui",
        "hasteachers": true,
        "mode": "Hybrid",
        "image": "",
        "detailurl": "https://example.com/theme/hikmah/course.php?id=3",
        "forms": [{"html": "<form></form>"}]
    }
}}
<div class="hk-apply">
    <aside class="hk-apply__course hk-panel">
        {{#mode}}<span class="hk-apply__mode">{{mode}}</span>{{/mode}}
        <p class="hk-apply__summary">{{summary}}</p>
        {{#hasteachers}}
            <p class="hk-apply__teachers"><span>{{#str}}card_teacher, theme_hikmah{{/str}}</span> {{teachers}}</p>
        {{/hasteachers}}
        <a class="hk-apply__details" href="{{detailurl}}">{{#str}}enrol_viewdetails, theme_hikmah{{/str}} <span aria-hidden="true">&rarr;</span></a>
    </aside>

    <section class="hk-apply__form hk-panel" aria-labelledby="hk-apply-title">
        <h2 id="hk-apply-title" class="hk-apply__title">{{#str}}enrol_applytitle, theme_hikmah{{/str}}</h2>
        <ol class="hk-apply__steps">
            <li>{{#str}}enrol_applystep1, theme_hikmah{{/str}}</li>
            <li>{{#str}}enrol_applystep2, theme_hikmah{{/str}}</li>
            <li>{{#str}}enrol_applystep3, theme_hikmah{{/str}}</li>
        </ol>
        {{#forms}}
            <div class="hk-apply__widget">{{{html}}}</div>
        {{/forms}}
    </section>
</div>
