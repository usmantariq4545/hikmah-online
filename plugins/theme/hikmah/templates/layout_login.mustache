{{!
    @template theme_hikmah/layout_login

    Login, sign-up and password reset: Hikmah artwork on one side, the form on the other.

    Example context (json):
    {
        "sitename": "Hikmah Online",
        "output": {"doctype": "<!DOCTYPE html>", "page_title": "Hikmah Online", "favicon": "favicon.ico", "main_content": "<h1>Headings make html validators happier</h1>", "hk_logo_light": "logo-light.svg", "hk_logo_dark": "logo-dark.svg", "hk_home_url": "#", "hk_policies_url": "#"},
        "bodyattributes": "",
        "motifclass": "hk-auth__motif hk-motif--animate"
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="hk-auth mt-0">
        <aside class="hk-auth__art" aria-hidden="true">
            {{> theme_hikmah/motif }}
            <a class="hk-auth__logo" href="{{output.hk_home_url}}" tabindex="-1">
                <img src="{{output.hk_logo_light}}" alt="">
            </a>
            <div class="hk-auth__quote">
                <span class="hk-eyebrow hk-eyebrow--light">{{#str}}auth_eyebrow, theme_hikmah{{/str}}</span>
                <h2>{{#str}}auth_title, theme_hikmah{{/str}}</h2>
                <p>{{#str}}auth_text, theme_hikmah{{/str}}</p>
            </div>
        </aside>
        <main class="hk-auth__panel" id="hk-main" role="main">
            <div class="hk-auth__card">
                <a class="hk-auth__mobile-logo" href="{{output.hk_home_url}}">
                    <img src="{{output.hk_logo_dark}}" alt="{{sitename}}">
                </a>
                {{{ output.course_content_header }}}
                {{{ output.main_content }}}
                <nav class="hk-auth__legal" aria-label="{{#str}}footer_privacy, theme_hikmah{{/str}}">
                    <a href="{{output.hk_home_url}}">{{#str}}backtohome, theme_hikmah{{/str}}</a>
                    <a href="{{output.hk_privacy_url}}">{{#str}}policy_privacy, theme_hikmah{{/str}}</a>
                    <a href="{{output.hk_terms_url}}">{{#str}}policy_terms, theme_hikmah{{/str}}</a>
                    <a href="{{output.hk_refund_url}}">{{#str}}policy_refund, theme_hikmah{{/str}}</a>
                    {{! Moodle's footer links: data retention summary and the mobile app. }}
                    {{{ output.standard_footer_html }}}
                </nav>
            </div>
        </main>
    </div>
    <footer>{{{ output.hk_footer }}}</footer>
    <div class="hk-auth__footer">
        {{{ output.standard_end_of_body_html }}}
        <div class="footer-content-debugging footer-dark bg-dark text-light">
            <div class="container-fluid footer-dark-inner">{{{ output.debug_footer_html }}}</div>
        </div>
    </div>
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
