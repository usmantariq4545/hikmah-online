{{!
    @template theme_hikmah/footer_site

    The site footer on every page (from the home page v2 design): mission and logo on the left, link
    columns on the right, newsletter row, then the rights line with the social icons.

    Context variables required for this template: see \theme_hikmah\local\footer::export().

    Example context (json):
    {
        "logo": "logo-light.svg",
        "sitename": "Hikmah Online",
        "year": "2026",
        "catalogurl": "#",
        "freeurl": "#",
        "liveurl": "#",
        "topicsurl": "#",
        "teachersurl": "#",
        "faqurl": "#",
        "verifyurl": "#",
        "policiesurl": "#",
        "whatsappurl": "#",
        "instagramurl": "#",
        "facebookurl": "#"
    }
}}
<div class="hk2-footer">
    <div class="hk2-footer__wrap">
        <div class="hk2-footer__grid">
            <div class="hk2-footer__brand"><img class="hk2-footer__logo" src="{{logo}}" alt="{{sitename}}" decoding="async"><p>{{#str}}home2_footer_mission, theme_hikmah{{/str}}</p></div>
            <div class="hk2-footer__cols">
                <nav aria-label="{{#str}}footer_learn, theme_hikmah{{/str}}">
                    <h2>{{#str}}footer_learn, theme_hikmah{{/str}}</h2>
                    <a href="{{catalogurl}}">{{#str}}home2_link_allcourses, theme_hikmah{{/str}}</a>
                    <a href="{{topicsurl}}">{{#str}}home2_link_topics, theme_hikmah{{/str}}</a>
                    <a href="{{freeurl}}">{{#str}}home2_link_free, theme_hikmah{{/str}}</a>
                    <a href="{{liveurl}}">{{#str}}home2_link_live, theme_hikmah{{/str}}</a>
                </nav>
                <nav aria-label="{{#str}}home2_footer_institute, theme_hikmah{{/str}}">
                    <h2>{{#str}}home2_footer_institute, theme_hikmah{{/str}}</h2>
                    <a href="#">{{#str}}home2_link_about, theme_hikmah{{/str}}</a>
                    <a href="{{teachersurl}}">{{#str}}home2_link_teachers, theme_hikmah{{/str}}</a>
                    <a href="#">{{#str}}home2_link_support, theme_hikmah{{/str}}</a>
                </nav>
                <nav aria-label="{{#str}}footer_help, theme_hikmah{{/str}}">
                    <h2>{{#str}}footer_help, theme_hikmah{{/str}}</h2>
                    <a href="{{faqurl}}">{{#str}}nav_faq, theme_hikmah{{/str}}</a>
                    <a href="{{whatsappurl}}" target="_blank" rel="noopener">{{#str}}home2_link_contact, theme_hikmah{{/str}}</a>
                    <a href="{{verifyurl}}">{{#str}}home2_link_verify, theme_hikmah{{/str}}</a>
                    <a href="{{policiesurl}}">{{#str}}footer_privacy, theme_hikmah{{/str}}</a>
                </nav>
            </div>
        </div>
        <div class="hk2-news">
            <label for="hk2-news-email">{{#str}}home2_news_label, theme_hikmah{{/str}}</label>
            <input id="hk2-news-email" type="email" autocomplete="email" placeholder="{{#str}}home2_news_placeholder, theme_hikmah{{/str}}">
            <button class="hk2-btn hk2-btn--sun" type="button">{{#str}}home2_news_button, theme_hikmah{{/str}}</button>
        </div>
        <div class="hk2-footer__base">
            <span>{{#str}}home2_footer_rights, theme_hikmah, {{year}}{{/str}}</span>
            <div class="hk2-footer__social">
                <a href="{{whatsappurl}}" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 20.5l1.2-4.1A8.5 8.5 0 1 1 8 19.6z"/><path d="M9 8.2c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.1.6l-.5.6c-.1.1-.1.3 0 .5.6 1 1.4 1.8 2.5 2.4.2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.3.3.5 0 .9-.7 1.7-1.6 1.8-1 .1-2.6-.3-4.3-1.9S8.7 10.8 8.8 9.6c0-.6.1-1 .2-1.4z"/></svg>
                </a>
                <a href="{{instagramurl}}" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle class="hk2-footer__dot" cx="17.2" cy="6.8" r="1"/></svg>
                </a>
                <a href="{{facebookurl}}" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8.8v3h2.6V21"/></svg>
                </a>
            </div>
        </div>
    </div>
</div>
