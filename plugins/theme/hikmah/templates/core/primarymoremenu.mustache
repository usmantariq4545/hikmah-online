{{!
    @template core/primarymoremenu

    Hikmah override: the top menu is rendered on the server and shown at once. Moodle 5.3 builds it
    with a React component that replaces this markup only after its scripts arrive and it has measured
    the items, so on a cold load the menu stayed blank for seconds and then appeared in another font
    (owner's report, 2026-11-20). core/moremenu still moves items that do not fit into "More".
    The nav starts "observed" so theme_boost's rule does not keep it hidden until that script runs.

    Example context (json):
    {
        "moremenuid": "614c104dbacfa",
        "navbarstyle": "navbar-nav",
        "istablist": false,
        "nodearray": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            }
        ]
    }
}}
<nav class="moremenu observed navigation hk-pending">
    <ul id="moremenu-{{moremenuid}}-{{navbarstyle}}" role="{{#istablist}}tablist{{/istablist}}{{^istablist}}menubar{{/istablist}}" class="nav more-nav {{navbarstyle}}">
        {{#nodecollection}}
            {{#children}}
                {{> core/moremenu_children}}
            {{/children}}
        {{/nodecollection}}
        {{#nodearray}}
            {{> core/moremenu_children}}
        {{/nodearray}}
        <li role="none" class="nav-item dropdown dropdownmoremenu d-none" data-region="morebutton">
            <a class="dropdown-toggle nav-link" href="#" id="moremenu-dropdown-{{moremenuid}}" role="{{#istablist}}tab{{/istablist}}{{^istablist}}menuitem{{/istablist}}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" tabindex="-1">
                {{#str}}moremenu, core{{/str}}
            </a>
            <ul class="dropdown-menu dropdown-menu-start" data-region="moredropdown" aria-labelledby="moremenu-dropdown-{{moremenuid}}" role="menu">
            </ul>
        </li>
    </ul>
</nav>
{{#js}}
    require(['core/moremenu'], function(moremenu) {
        var menu = document.querySelector('#moremenu-{{moremenuid}}-{{navbarstyle}}');
        moremenu(menu);
        menu.parentNode.classList.remove('hk-pending');
    });
{{/js}}
