{{!
    @template theme_boost/navbar

    Hikmah override of the Boost navbar: Hikmah mark, primary navigation, and clear sign-in /
    create-account actions for visitors.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50",
            "custom_menu": "<li>..</li>",
            "page_heading_menu": "<li>..</li>",
            "search_box": "<div><input type='text'></div>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>",
            "user_menu": "<div class='dropdown'>John Doe</div>"
        },
        "config": {
            "wwwroot": "#",
            "homeurl": "/my/"
        },
        "sitename": "Hikmah Online",
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            }
        ]
    }
}}
<nav class="navbar fixed-top bg-body navbar-expand hk-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid">
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        <a href="{{output.hk_home_url}}" class="navbar-brand hk-navbar__brand d-flex align-items-center m-0 me-4 p-0 aabtn">
            <img src="{{output.hk_logo_dark}}" class="hk-navbar__logo" alt="{{sitename}}" fetchpriority="high">
        </a>
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/primarymoremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                <!-- page_heading_menu -->
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto h-100">
            {{# output.search_box }}
                {{{ output.search_box }}}
            {{/output.search_box}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/langmenu}}
            {{{ output.edit_switch }}}
            {{# output.navbar_plugin_output }}
            {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.navbar_plugin_output}}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
            {{#output.hk_can_signup}}
                <div class="d-none d-sm-flex align-items-center ms-2">
                    <a class="hk-btn hk-btn--sun hk-btn--sm" href="{{output.hk_signup_url}}">{{#str}}nav_signup, theme_hikmah{{/str}}</a>
                </div>
            {{/output.hk_can_signup}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}
