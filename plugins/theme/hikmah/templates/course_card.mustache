{{!
    @template theme_hikmah/course_card

    One catalog course card.

    Example context (json):
    {
        "id": 4,
        "url": "#",
        "fullname": "Foundations of Tajweed",
        "summary": "Learn to recite with correct articulation.",
        "category": "Qur'an",
        "image": null,
        "hue": 200,
        "mode": "Live",
        "islive": true,
        "language": "English",
        "teachers": "Ustadh Ahmad",
        "hasteachers": true,
        "startdate": "12/01/27",
        "isfree": false,
        "pricelabel": "PKR 4,500",
        "pricecurrency": "PKR",
        "priceamount": "4,500",
        "status": {"label": "Enrolling now", "class": "hk-chip--success"}
    }
}}
<article class="hk-course" data-hk-reveal>
    <div class="hk-course__media">
        {{#image}}<img src="{{image}}" alt="" loading="lazy">{{/image}}
        {{^image}}
            <div class="hk-course__cover" style="--hk-hue: {{hue}}">
                {{> theme_hikmah/motif }}
                <span class="hk-course__cover-word">{{category}}</span>
            </div>
        {{/image}}
        <div class="hk-course__badges">
            {{#mode}}
                <span class="hk-chip hk-chip--ink{{#islive}} hk-chip--live{{/islive}}">
                    {{#islive}}<span class="hk-chip__dot"></span>{{/islive}}{{mode}}
                </span>
            {{/mode}}
            {{#status}}<span class="hk-chip {{class}}">{{label}}</span>{{/status}}
        </div>
    </div>
    <div class="hk-course__body">
        <div class="hk-course__category">{{category}}</div>
        <h3 class="hk-course__title"><a href="{{url}}">{{{fullname}}}</a></h3>
        {{#summary}}<p class="hk-course__summary">{{summary}}</p>{{/summary}}
        <div class="hk-course__meta">
            {{#hasteachers}}
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6"/></svg>
                    <span class="visually-hidden">{{#str}}card_teacher, theme_hikmah{{/str}}</span>{{teachers}}
                </span>
            {{/hasteachers}}
            {{#language}}
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.400-3.800 9c-2.500-2.600-3.800-5.600-3.800-9S9.500 5.600 12 3z"/></svg>
                    <span class="visually-hidden">{{#str}}card_language, theme_hikmah{{/str}}</span>{{language}}
                </span>
            {{/language}}
            {{#startdate}}
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.500" y="5" width="17" height="15" rx="2.500"/><path d="M8 3v4M16 3v4M3.500 10h17"/></svg>
                    <span class="visually-hidden">{{#str}}card_starts, theme_hikmah{{/str}}</span>{{startdate}}
                </span>
            {{/startdate}}
        </div>
        <div class="hk-course__foot">
            <div class="hk-course__price">
                {{#isfree}}{{pricelabel}}{{/isfree}}
                {{^isfree}}<small>{{pricecurrency}}</small>{{priceamount}}{{/isfree}}
            </div>
            <span class="hk-course__cta" aria-hidden="true">
                {{#str}}card_view, theme_hikmah{{/str}} <span class="hk-course__cta-arrow">→</span>
            </span>
        </div>
    </div>
</article>
