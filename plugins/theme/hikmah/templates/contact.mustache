{{!
    @template theme_hikmah/contact

    Contact us page: ways to reach Hikmah, Moodle's contact form and quick answers.

    Context variables required for this template: see \theme_hikmah\local\pages::contact().

    Example context (json):
    {
        "pix": "/theme/hikmah/pix/home2/",
        "whatsappurl": "#",
        "instagramurl": "#",
        "facebookurl": "#",
        "email": "info@example.com",
        "faqurl": "#",
        "policiesurl": "#",
        "contacturl": "#",
        "form": "<form></form>",
        "hasform": true,
        "sent": false,
        "failed": false,
        "loginurl": "#",
        "faqs": [{"title": "Who are the courses for?", "text": "Everyone.", "open": true}]
    }
}}
<div class="hk2">

    <section class="hk2-pagehero">
        <img class="hk2-pagehero__art" src="{{pix}}rosette.svg" alt="">
        <div class="hk2-wrap">
            <span class="hk2-eyebrow hk2-hero__eyebrow">{{#str}}contact_eyebrow, theme_hikmah{{/str}}</span>
            <h1 class="hk2-pagehero__title">{{#str}}contact_hero_title, theme_hikmah{{/str}} <span class="hk2-mark">{{#str}}contact_hero_mark, theme_hikmah{{/str}}</span></h1>
            <p class="hk2-pagehero__lead">{{#str}}contact_hero_lead, theme_hikmah{{/str}}</p>
        </div>
    </section>

    <section class="hk2-reach-band" aria-label="{{#str}}contact_ways_label, theme_hikmah{{/str}}">
        <div class="hk2-wrap">
            <ul class="hk2-reach" data-hk-stagger>
                <li><a class="hk2-reach__card hk2-reach__card--ink" href="{{whatsappurl}}" target="_blank" rel="noopener">
                    <span class="hk2-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 20.5l1.2-4.1A8.5 8.5 0 1 1 8 19.6z"/><path d="M9 8.2c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.1.6l-.5.6c-.1.1-.1.3 0 .5.6 1 1.4 1.8 2.5 2.4.2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.3.3.5 0 .9-.7 1.7-1.6 1.8-1 .1-2.6-.3-4.3-1.9S8.7 10.8 8.8 9.6c0-.6.1-1 .2-1.4z"/></svg></span>
                    <h2>{{#str}}contact_whatsapp, theme_hikmah{{/str}}</h2>
                    <p>{{#str}}contact_whatsapp_text, theme_hikmah{{/str}}</p>
                    <strong dir="ltr">{{#str}}contact_whatsapp_number, theme_hikmah{{/str}}</strong>
                    <span class="hk2-reach__go">{{#str}}contact_whatsapp_go, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</span>
                </a></li>
                <li><a class="hk2-reach__card" href="mailto:{{email}}">
                    <span class="hk2-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9A2.5 2.5 0 0 1 5.5 5z"/><path d="m4 7 8 6 8-6"/></svg></span>
                    <h2>{{#str}}contact_email, theme_hikmah{{/str}}</h2>
                    <p>{{#str}}contact_email_text, theme_hikmah{{/str}}</p>
                    <strong>{{email}}</strong>
                    <span class="hk2-reach__go">{{#str}}contact_email_go, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</span>
                </a></li>
                <li><a class="hk2-reach__card" href="{{instagramurl}}" target="_blank" rel="noopener">
                    <span class="hk2-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8.5 3.5h7a5 5 0 0 1 5 5v7a5 5 0 0 1-5 5h-7a5 5 0 0 1-5-5v-7a5 5 0 0 1 5-5z"/><path d="M12 8a4 4 0 1 0 0 8 4 4 0 1 0 0-8z"/><path d="M17.2 6.8h.01"/></svg></span>
                    <h2>{{#str}}contact_instagram, theme_hikmah{{/str}}</h2>
                    <p>{{#str}}contact_instagram_text, theme_hikmah{{/str}}</p>
                    <strong>{{#str}}contact_instagram_handle, theme_hikmah{{/str}}</strong>
                    <span class="hk2-reach__go">{{#str}}contact_instagram_go, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</span>
                </a></li>
                <li><a class="hk2-reach__card" href="{{facebookurl}}" target="_blank" rel="noopener">
                    <span class="hk2-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8.8v3h2.6V21"/></svg></span>
                    <h2>{{#str}}contact_facebook, theme_hikmah{{/str}}</h2>
                    <p>{{#str}}contact_facebook_text, theme_hikmah{{/str}}</p>
                    <strong>{{#str}}contact_facebook_handle, theme_hikmah{{/str}}</strong>
                    <span class="hk2-reach__go">{{#str}}contact_facebook_go, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</span>
                </a></li>
            </ul>
        </div>
    </section>

    <section class="hk2-section">
        <div class="hk2-wrap hk2-contact">
            <div class="hk2-contact__form" id="hk2-message">
                {{#sent}}
                    <div class="hk2-contact__sent" role="status">
                        <span class="hk2-contact__tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></svg></span>
                        <h2>{{#str}}contact_sent_title, theme_hikmah{{/str}}</h2>
                        <p>{{#str}}contact_sent_text, theme_hikmah{{/str}}</p>
                        <a class="hk2-btn hk2-btn--ghost" href="{{contacturl}}#hk2-message">{{#str}}contact_sent_again, theme_hikmah{{/str}}</a>
                    </div>
                {{/sent}}
                {{^sent}}
                    <h2>{{#str}}contact_form_title, theme_hikmah{{/str}}</h2>
                    {{#hasform}}
                        <p class="hk2-muted">{{#str}}contact_form_lead, theme_hikmah{{/str}}</p>
                        {{#failed}}<div class="alert alert-warning" role="alert">{{#str}}contact_failed, theme_hikmah{{/str}}</div>{{/failed}}
                        <div class="hk2-contact__fields">{{{form}}}</div>
                        <p class="hk2-contact__note">{{#str}}contact_privacy, theme_hikmah, {{policiesurl}}{{/str}}</p>
                    {{/hasform}}
                    {{^hasform}}
                        <p class="hk2-muted">{{#str}}contact_noform, theme_hikmah{{/str}}</p>
                        <div class="hk2-actions">
                            <a class="hk2-btn hk2-btn--sun" href="{{whatsappurl}}" target="_blank" rel="noopener">{{#str}}contact_whatsapp_go, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
                            <a class="hk2-btn hk2-btn--ghost" href="{{loginurl}}">{{#str}}login{{/str}}</a>
                        </div>
                    {{/hasform}}
                {{/sent}}
            </div>
            <aside class="hk2-contact__aside">
                <h2>{{#str}}contact_quick_title, theme_hikmah{{/str}}</h2>
                <p class="hk2-muted">{{#str}}contact_quick_lead, theme_hikmah{{/str}}</p>
                <div class="hk2-faq hk2-faq--compact">
                    {{#faqs}}
                        <details{{#open}} open{{/open}}><summary>{{title}}<span class="hk2-faq__icon" aria-hidden="true"></span></summary><p>{{text}}</p></details>
                    {{/faqs}}
                </div>
                <a class="hk2-link" href="{{faqurl}}">{{#str}}faq_all, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
            </aside>
        </div>
    </section>

</div>
