{{!
    @template theme_hikmah/home2

    Draft home page v2 (site administrators only for now), built from the design canvas.

    Example context (json):
    {
        "pix": "/theme/hikmah/pix/home2/",
        "logo": "/theme/hikmah/pix/logo-light.png",
        "sitename": "Hikmah Online",
        "catalogurl": "#",
        "primaryurl": "#",
        "faqurl": "#",
        "homeurl": "#",
        "whatsappurl": "#",
        "freeurl": "#",
        "liveurl": "#",
        "verifyurl": "#",
        "policiesurl": "#",
        "khizerphoto": "khizer.webp",
        "year": "2026",
        "promises": [{"title": "Grounded in tradition", "text": "Taught by trained scholars."}],
        "sessions": [{"title": "Sources of Islamic Law", "text": "(Tue 1 Dec)"}],
        "times": [{"title": "Pakistan (PKT)", "text": "8:00–9:30 PM"}],
        "courses": [],
        "topics": [{"name": "Seerah", "text": "Walk with the Prophet.", "tag1": "Makkan period", "tag2": "Character", "alt": "A mosque", "image": "seerah.jpg", "url": "#"}],
        "steps": [{"title": "Create your account", "text": "Sign up with your email."}],
        "teachers": [{"name": "Khizer Khalid", "photo": "khizer.webp", "big": true, "lift": 0, "creds": [{"text": "LUMS Graduate"}]}],
        "ways": [{"title": "Live", "text": "Evening classes."}],
        "points": [{"title": "A few minutes", "text": ""}],
        "faqs": [{"title": "How do I enroll?", "text": "Open the course.", "open": true}]
    }
}}
<div class="hk2">

    <a class="hk2-announce" href="#hk2-featured">
        <span class="hk2-chip hk2-chip--sun">{{#str}}home2_announce_new, theme_hikmah{{/str}}</span>
        <span class="hk2-announce__text">{{#str}}home2_announce_text, theme_hikmah{{/str}}</span>
        <span class="hk2-announce__more">{{#str}}home2_enroll, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</span>
    </a>

    <section class="hk2-hero">
        <div class="hk2-wrap hk2-hero__grid">
            <div>
                <span class="hk2-eyebrow hk2-eyebrow--light hk2-hero__eyebrow">{{#str}}home2_hero_eyebrow, theme_hikmah{{/str}}</span>
                <h1 class="hk2-hero__title">{{#str}}home2_hero_line1, theme_hikmah{{/str}} {{#str}}home2_hero_line2, theme_hikmah{{/str}} <span class="hk2-mark">{{#str}}home2_hero_mark, theme_hikmah{{/str}}</span></h1>
                <p class="hk2-hero__lead">{{#str}}home2_hero_lead, theme_hikmah{{/str}}</p>
                <div class="hk2-actions">
                    <a class="hk2-btn hk2-btn--sun" href="{{primaryurl}}">{{#str}}home2_apply, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
                    <a class="hk2-btn hk2-btn--ghostlight" href="{{catalogurl}}">{{#str}}home2_browse, theme_hikmah{{/str}}</a>
                </div>
            </div>
            <div class="hk2-hero__art" aria-hidden="true">
                {{> theme_hikmah/home2_rosette }}
                <span lang="ar">حكمة</span>
            </div>
        </div>
    </section>

    <section class="hk2-promises-band" aria-label="{{#str}}home2_promises_label, theme_hikmah{{/str}}">
        <div class="hk2-wrap">
            <ul class="hk2-promises" data-hk-stagger>
                {{#promises}}
                    <li>
                        <span class="hk2-icon" aria-hidden="true"><svg viewBox="0 0 24 24">{{#icon}}<path d="{{.}}"/>{{/icon}}</svg></span>
                        <h2>{{title}}</h2>
                        <p>{{text}}</p>
                    </li>
                {{/promises}}
            </ul>
        </div>
    </section>

    <section class="hk2-section" id="hk2-featured">
        <div class="hk2-wrap hk2-spot">
            <div data-hk-reveal="left">
                <span class="hk2-chip hk2-chip--sun hk2-spot__new"><span class="hk2-dot hk2-dot--sky"></span>{{#str}}home2_announce_new, theme_hikmah{{/str}}</span>
                <p class="hk2-spot__kicker">{{#str}}home2_spot_eyebrow, theme_hikmah{{/str}}</p>
                <h2 class="hk2-title hk2-spot__title">{{#str}}home2_spot_title, theme_hikmah{{/str}} <span class="hk2-spot__mark">{{#str}}home2_spot_title_mark, theme_hikmah{{/str}}</span></h2>
                <p class="hk2-lead">{{#str}}home2_spot_lead, theme_hikmah{{/str}}</p>
                <div class="hk2-chips">
                    <span class="hk2-chip hk2-chip--ink">{{#str}}home2_spot_dates, theme_hikmah{{/str}}</span>
                    <span class="hk2-chip hk2-chip--sun"><span class="hk2-dot"></span>{{#str}}home2_spot_live, theme_hikmah{{/str}}</span>
                    <span class="hk2-chip">{{#str}}home2_spot_sessions, theme_hikmah{{/str}}</span>
                    <span class="hk2-chip">{{#str}}home2_topic_sharia, theme_hikmah{{/str}}</span>
                </div>
                <h3 class="hk2-spot__sub">{{#str}}home2_spot_cover, theme_hikmah{{/str}}</h3>
                <ol class="hk2-spot__sessions">
                    {{#sessions}}<li><strong>{{title}}</strong> {{text}}</li>{{/sessions}}
                </ol>
                <div class="hk2-spot__teacher">
                    {{#khizerphoto}}<img src="{{khizerphoto}}" alt="">{{/khizerphoto}}
                    <div>
                        <div class="hk2-spot__name">{{#str}}home2_teacher_khizer, theme_hikmah{{/str}}</div>
                        <div class="hk2-muted">{{#str}}home2_teacher_khizer_cred1, theme_hikmah{{/str}} · {{#str}}home2_teacher_khizer_cred2, theme_hikmah{{/str}}</div>
                    </div>
                </div>
            </div>
            <aside class="hk2-enroll" data-hk-reveal="right" aria-label="{{#str}}detail_enrol, theme_hikmah{{/str}}">
                <div class="hk2-enroll__media">
                    {{> theme_hikmah/home2_rosette }}
                    <span>{{#str}}home2_topic_sharia, theme_hikmah{{/str}}</span>
                </div>
                <div class="hk2-enroll__body">
                    <div class="hk2-enroll__price-box">
                        <div class="hk2-enroll__price"><small>PKR</small>{{#str}}home2_spot_price, theme_hikmah{{/str}}</div>
                        <p class="hk2-muted">{{#str}}home2_spot_pricenote, theme_hikmah{{/str}}</p>
                    </div>
                    <table class="hk2-enroll__times table-reboot">
                        <caption>{{#str}}home2_spot_times, theme_hikmah{{/str}}</caption>
                        <tbody>
                            {{#times}}<tr><th scope="row">{{title}}</th><td>{{text}}</td></tr>{{/times}}
                        </tbody>
                    </table>
                    <div class="hk2-enroll__actions">
                        <a class="hk2-btn hk2-btn--sun hk2-btn--block" href="{{catalogurl}}">{{#str}}home2_enroll, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
                        <a class="hk2-link" href="{{catalogurl}}">{{#str}}home2_spot_details, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
                        <p class="hk2-muted">{{#str}}home2_spot_note, theme_hikmah{{/str}}</p>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    {{#courses.0}}
    <section class="hk2-section hk2-section--tint">
        <div class="hk2-wrap">
            <header class="hk2-head" data-hk-reveal>
                <span class="hk2-eyebrow">{{#str}}home2_courses_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk2-title">{{#str}}home2_courses_title, theme_hikmah{{/str}}</h2>
                <p class="hk2-lead">{{#str}}home2_courses_lead, theme_hikmah{{/str}}</p>
            </header>
            <div class="hk2-courses" data-hk2-track="courses" data-hk2-every="2800">
                {{#courses}}{{> theme_hikmah/course_card }}{{/courses}}
            </div>
            <div class="hk2-center">
                <a class="hk2-btn" href="{{catalogurl}}">{{#str}}home2_courses_all, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
            </div>
        </div>
    </section>
    {{/courses.0}}

    <section class="hk2-section" id="hk2-topics">
        <div class="hk2-wrap">
            <header class="hk2-head hk2-head--split" data-hk-reveal>
                <div>
                    <span class="hk2-eyebrow">{{#str}}home2_topics_eyebrow, theme_hikmah{{/str}}</span>
                    <h2 class="hk2-title">{{#str}}home2_topics_title, theme_hikmah{{/str}}</h2>
                    <p class="hk2-lead">{{#str}}home2_topics_lead, theme_hikmah{{/str}}</p>
                </div>
            </header>
            <div class="hk2-carousel">
                <div class="hk2-topics" data-hk-stagger data-hk2-track="topics" data-hk2-every="2500" role="region" aria-label="{{#str}}home2_topics_label, theme_hikmah{{/str}}">
                    {{#topics}}
                        <article class="hk2-topic">
                            <div class="hk2-topic__tags"><span>{{tag1}}</span><span>{{tag2}}</span></div>
                            <h3 class="hk2-topic__title">{{name}}</h3>
                            <p class="hk2-topic__text">{{text}}</p>
                            <div class="hk2-topic__media">
                                <img src="{{image}}" alt="{{alt}}" loading="lazy">
                                <a class="hk2-topic__btn" href="{{url}}">{{#str}}home2_browse_more, theme_hikmah{{/str}}<span>{{> theme_hikmah/home2_arrow }}</span></a>
                            </div>
                        </article>
                    {{/topics}}
                </div>
                <button type="button" class="hk2-nav__btn hk2-nav__btn--prev" data-hk2-prev="topics" aria-label="{{#str}}home2_topics_prev, theme_hikmah{{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
                <button type="button" class="hk2-nav__btn hk2-nav__btn--next" data-hk2-next="topics" aria-label="{{#str}}home2_topics_next, theme_hikmah{{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
            </div>
        </div>
    </section>

    <section class="hk2-section hk2-section--tint hk2-section--tight">
        <div class="hk2-wrap">
            <header class="hk2-head hk2-head--split" data-hk-reveal>
                <div>
                    <span class="hk2-eyebrow">{{#str}}home2_steps_eyebrow, theme_hikmah{{/str}}</span>
                    <h2 class="hk2-title hk2-title--sm">{{#str}}home2_steps_title, theme_hikmah{{/str}}</h2>
                </div>
                <a class="hk2-btn" href="{{catalogurl}}">{{#str}}home2_explore, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
            </header>
            <ol class="hk2-steps" data-hk-stagger>
                {{#steps}}
                    <li><span class="hk2-steps__num" aria-hidden="true"></span><div><h3>{{title}}</h3><p>{{text}}</p></div></li>
                {{/steps}}
            </ol>
        </div>
    </section>

    <section class="hk2-section hk2-section--clip" id="hk2-teachers">
        <div class="hk2-wrap">
            <header class="hk2-head hk2-head--center" data-hk-reveal>
                <span class="hk2-eyebrow hk2-eyebrow--plain">{{#str}}home2_teachers_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk2-title">{{#str}}home2_teachers_title, theme_hikmah{{/str}}</h2>
                <p class="hk2-lead">{{#str}}home2_teachers_lead, theme_hikmah{{/str}}</p>
            </header>
            <div class="hk2-team" data-hk-reveal data-hk2-track="teachers" data-hk2-every="2500">
                {{#teachers}}
                    <article class="hk2-person{{#big}} hk2-person--big{{/big}}" style="--hk2-lift: {{lift}}px">
                        <div class="hk2-person__photo">
                            {{#photo}}<img src="{{photo}}" alt="{{name}}" loading="lazy">{{/photo}}
                            {{^photo}}<svg class="hk2-person__outline" viewBox="0 0 200 240" aria-hidden="true"><circle cx="100" cy="86" r="40"/><path d="M24 240c0-48 34-84 76-84s76 36 76 84"/></svg>{{/photo}}
                        </div>
                        <div class="hk2-person__label">
                            <div class="hk2-person__name">{{name}}</div>
                            {{#creds}}<div class="hk2-person__cred">{{text}}</div>{{/creds}}
                        </div>
                    </article>
                {{/teachers}}
            </div>
            <div class="hk2-team-foot">
                <p class="hk2-muted">{{#str}}home2_teachers_note, theme_hikmah{{/str}}</p>
                <a class="hk2-link" href="{{catalogurl}}">{{#str}}home2_teachers_all, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
            </div>
        </div>
    </section>

    <section class="hk2-section hk2-section--tint hk2-section--tight">
        <div class="hk2-wrap">
            <header class="hk2-head" data-hk-reveal>
                <span class="hk2-eyebrow">{{#str}}home2_ways_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk2-title hk2-title--sm">{{#str}}home2_ways_title, theme_hikmah{{/str}}</h2>
            </header>
            <ul class="hk2-ways" data-hk-stagger>
                {{#ways}}
                    <li><span class="hk2-icon hk2-icon--sm" aria-hidden="true"><svg viewBox="0 0 24 24">{{#icon}}<path d="{{.}}"/>{{/icon}}</svg></span><div><h3>{{title}}</h3><p>{{text}}</p></div></li>
                {{/ways}}
            </ul>
        </div>
    </section>

    <section class="hk2-start">
        <div class="hk2-wrap hk2-start__grid">
            <div data-hk-reveal="left">
                <span class="hk2-eyebrow hk2-eyebrow--light">{{#str}}home2_start_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk2-title">{{#str}}home2_start_title, theme_hikmah{{/str}}</h2>
                <p class="hk2-start__lead">{{#str}}home2_start_lead, theme_hikmah{{/str}}</p>
                <ul class="hk2-start__points">
                    {{#points}}<li><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></svg></span>{{title}}</li>{{/points}}
                </ul>
            </div>
            <a class="hk2-video" data-hk-reveal="scale" href="{{homeurl}}" aria-label="{{#str}}home2_start_play, theme_hikmah{{/str}}">
                {{> theme_hikmah/home2_rosette }}
                <span class="hk2-video__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg></span>
                <span class="hk2-video__label">{{#str}}home2_start_watch, theme_hikmah{{/str}}</span>
                <span class="hk2-chip hk2-chip--glass">{{#str}}home2_start_length, theme_hikmah{{/str}}</span>
            </a>
        </div>
    </section>

    <section class="hk2-section hk2-section--tint" id="hk2-faq">
        <div class="hk2-wrap">
            <header class="hk2-head hk2-head--center" data-hk-reveal>
                <span class="hk2-eyebrow hk2-eyebrow--plain">{{#str}}home2_faq_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk2-title">{{#str}}home2_faq_title, theme_hikmah{{/str}}</h2>
            </header>
            <div class="hk2-faq" data-hk-stagger>
                {{#faqs}}
                    <details{{#open}} open{{/open}}><summary>{{title}}<span class="hk2-faq__icon" aria-hidden="true"></span></summary><p>{{text}}</p></details>
                {{/faqs}}
            </div>
            <p class="hk2-center"><a class="hk2-link" href="{{whatsappurl}}" target="_blank" rel="noopener">{{#str}}home2_faq_contact, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a></p>
        </div>
    </section>

    <section class="hk2-verse">
        <img src="{{pix}}rosette.svg" alt="">
        <figure class="hk2-wrap">
            <blockquote data-hk-reveal>
                <p class="hk2-verse__arabic" lang="ar" dir="rtl">وَقُل رَّبِّ زِدْنِي عِلْمًا</p>
                <p class="hk2-verse__text">{{#str}}home2_verse_text, theme_hikmah{{/str}}</p>
            </blockquote>
            <figcaption>{{#str}}home2_verse_source, theme_hikmah{{/str}}</figcaption>
        </figure>
    </section>

    <section class="hk2-section">
        <div class="hk2-wrap">
            <div class="hk2-cta" data-hk-reveal="scale">
                <img src="{{pix}}rosette-ink.svg" alt="">
                <div>
                    <h2>{{#str}}home2_cta_title, theme_hikmah{{/str}}</h2>
                    <p>{{#str}}home2_cta_lead, theme_hikmah{{/str}}</p>
                </div>
                <div class="hk2-actions">
                    <a class="hk2-btn" href="{{primaryurl}}">{{#str}}home2_apply, theme_hikmah{{/str}}{{> theme_hikmah/home2_arrow }}</a>
                    <a class="hk2-btn hk2-btn--ghost" href="{{catalogurl}}">{{#str}}home2_browse, theme_hikmah{{/str}}</a>
                </div>
            </div>
        </div>
    </section>

</div>
{{#js}}
require(['theme_hikmah/home2'], function(home2) {
    home2.init();
});
{{/js}}
