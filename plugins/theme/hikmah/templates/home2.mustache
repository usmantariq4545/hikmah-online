{{!
    @template theme_hikmah/home2

    Draft home page v2 (site administrators only for now).

    Example context (json):
    {
        "catalogurl": "#",
        "faqurl": "#",
        "freeurl": "#",
        "liveurl": "#",
        "selfpacedurl": "#",
        "hybridurl": "#",
        "primaryurl": "#",
        "primarylabel": "Create your free account",
        "announce": {"fullname": "The World Behind an Islamic Ruling", "startdate": "Starts 01 Dec", "url": "#"},
        "promises": [{"title": "Grounded in tradition", "text": "Taught by trained scholars."}],
        "topics": [{"name": "Seerah", "text": "Walk with the Prophet.", "url": "#"}],
        "spotlight": false,
        "grid": [],
        "steps": [{"title": "Create your free account.", "text": "Sign up in under a minute."}],
        "teachers": [{"name": "Khizer Khalid", "initials": "KK", "courses": "The World Behind an Islamic Ruling"}],
        "quotes": [{"title": "This course gave me clarity.", "text": "Student, university"}],
        "faqs": [{"title": "Is it really free to join?", "text": "Yes."}]
    }
}}
<div class="hk-home2">

    {{#announce}}
        <a class="hk-h2-announce" href="{{url}}">
            <span class="hk-chip hk-chip--sun">{{#str}}home2_announce_new, theme_hikmah{{/str}}</span>
            <span class="hk-h2-announce__text">{{{fullname}}} · {{startdate}}</span>
            <span class="hk-h2-announce__more">{{#str}}home2_enrol, theme_hikmah{{/str}} <span class="hk-btn__arrow" aria-hidden="true">→</span></span>
        </a>
    {{/announce}}

    <section class="hk-hero">
        <div class="hk-container hk-hero__grid">
            <div class="hk-hero__copy">
                <span class="hk-eyebrow hk-eyebrow--light hk-hero__eyebrow">{{#str}}home2_hero_eyebrow, theme_hikmah{{/str}}</span>
                <h1 class="hk-hero__title hk-h2-hero__title">
                    <span class="hk-hero__line"><span>{{#str}}home2_hero_line1, theme_hikmah{{/str}}</span></span>
                    <span class="hk-hero__line"><span>{{#str}}home2_hero_line2, theme_hikmah{{/str}} <span class="hk-mark">{{#str}}home2_hero_mark, theme_hikmah{{/str}}</span></span></span>
                </h1>
                <p class="hk-hero__lead">{{#str}}home2_hero_lead, theme_hikmah{{/str}}</p>
                <div class="hk-hero__actions">
                    <a class="hk-btn hk-btn--sun" href="{{primaryurl}}">{{primarylabel}} <span class="hk-btn__arrow" aria-hidden="true">→</span></a>
                    <a class="hk-btn hk-btn--ghost-light" href="{{catalogurl}}">{{#str}}home2_browse, theme_hikmah{{/str}}</a>
                </div>
                <p class="hk-h2-hero__micro">{{#str}}home2_hero_micro, theme_hikmah{{/str}}</p>
            </div>
            <div class="hk-hero__art" aria-hidden="true">
                {{#heromotif}}{{> theme_hikmah/motif }}{{/heromotif}}
                <div class="hk-hero__word" lang="ar">حكمة</div>
            </div>
        </div>
        <svg class="hk-hero__curve" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 90h1440V38C1180 4 880 0 720 0S260 4 0 38z"/></svg>
    </section>

    <section class="hk-h2-promises" aria-label="{{#str}}home2_promises_label, theme_hikmah{{/str}}">
        <div class="hk-container">
            <ul class="hk-h2-promises__grid list-unstyled m-0" data-hk-stagger>
                {{#promises}}
                    <li class="hk-h2-promise">
                        <span class="hk-mode__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 4.5L19 7"/></svg>
                        </span>
                        <h2 class="hk-h2-promise__title">{{title}}</h2>
                        <p class="hk-h2-promise__text">{{text}}</p>
                    </li>
                {{/promises}}
            </ul>
        </div>
    </section>

    <section class="hk-section">
        <div class="hk-container">
            <header class="hk-section__head" data-hk-reveal>
                <span class="hk-eyebrow">{{#str}}home2_topics_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk-section__title">{{#str}}home2_topics_title, theme_hikmah{{/str}}</h2>
                <p class="hk-section__lead">{{#str}}home2_topics_lead, theme_hikmah{{/str}}</p>
            </header>
            <ul class="hk-h2-topics list-unstyled m-0" data-hk-stagger>
                {{#topics}}
                    <li><a class="hk-h2-topic" href="{{url}}"><span class="hk-h2-topic__name">{{name}}</span><span class="hk-h2-topic__text">{{text}}</span></a></li>
                {{/topics}}
            </ul>
        </div>
    </section>

    {{#spotlight}}
    <section class="hk-section hk-section--tint">
        <div class="hk-container hk-h2-spot">
            <div class="hk-h2-spot__copy" data-hk-reveal>
                <span class="hk-eyebrow">{{#str}}home2_spot_eyebrow, theme_hikmah, {{category}}{{/str}}</span>
                <h2 class="hk-section__title">{{{fullname}}}</h2>
                {{#summary}}<p class="hk-section__lead">{{summary}}</p>{{/summary}}
                <div class="hk-detail__chips">
                    {{#startdate}}<span class="hk-chip hk-chip--ink">{{startdate}}</span>{{/startdate}}
                    {{#mode}}<span class="hk-chip hk-chip--sun{{#islive}} hk-chip--live{{/islive}}">{{#islive}}<span class="hk-chip__dot"></span>{{/islive}}{{mode}}</span>{{/mode}}
                    {{#language}}<span class="hk-chip">{{language}}</span>{{/language}}
                    {{#length}}<span class="hk-chip">{{length}}</span>{{/length}}
                </div>
                {{#syllabus.0}}
                    <h3 class="hk-h2-spot__sub">{{#str}}home2_spot_cover, theme_hikmah{{/str}}</h3>
                    <ol class="hk-h2-spot__sessions">
                        {{#syllabus}}<li>{{{name}}}</li>{{/syllabus}}
                    </ol>
                {{/syllabus.0}}
                {{#hasteacherlist}}
                    <div class="hk-teachers mt-4">
                        {{#teacherlist}}
                            <div class="hk-teacher">
                                <span class="hk-teacher__initials" aria-hidden="true">{{initials}}</span>
                                <div><div class="hk-teacher__name">{{name}}</div><div class="hk-teacher__role">{{role}}</div></div>
                            </div>
                        {{/teacherlist}}
                    </div>
                {{/hasteacherlist}}
            </div>
            <aside class="hk-enrol" aria-label="{{#str}}detail_enrol, theme_hikmah{{/str}}" data-hk-reveal="scale">
                <div class="hk-enrol__media">
                    {{#image}}<img src="{{image}}" alt="">{{/image}}
                    {{^image}}
                        <div class="hk-course__cover" style="--hk-hue: {{hue}}">
                            {{> theme_hikmah/motif }}
                            <span class="hk-course__cover-word">{{category}}</span>
                        </div>
                    {{/image}}
                </div>
                <div class="hk-enrol__body">
                    <div class="hk-enrol__price">
                        {{#isfree}}{{pricelabel}}{{/isfree}}
                        {{^isfree}}<small>{{pricecurrency}}</small>{{priceamount}}{{/isfree}}
                    </div>
                    {{#schedule}}
                        <p class="hk-h2-spot__schedule">{{schedule}}</p>
                        <p class="hk-enrol__note">{{#str}}detail_timezone, theme_hikmah, {{timezone}}{{/str}}</p>
                    {{/schedule}}
                    <a class="hk-btn hk-btn--sun hk-btn--block" href="{{url}}">{{#str}}home2_enrol, theme_hikmah{{/str}} <span class="hk-btn__arrow" aria-hidden="true">→</span></a>
                    <p class="hk-enrol__note mt-3 mb-0">{{#str}}home2_spot_note, theme_hikmah{{/str}}</p>
                </div>
            </aside>
        </div>
    </section>
    {{/spotlight}}

    {{#grid.0}}
    <section class="hk-section hk-section--tint">
        <div class="hk-container">
            <header class="hk-section__head" data-hk-reveal>
                <span class="hk-eyebrow">{{#str}}featured_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk-section__title">{{#str}}featured_title, theme_hikmah{{/str}}</h2>
            </header>
            <div class="hk-courses" data-hk-stagger>
                {{#grid}}{{> theme_hikmah/course_card }}{{/grid}}
            </div>
            <div class="text-center mt-5" data-hk-reveal>
                <a class="hk-btn" href="{{catalogurl}}">{{#str}}home2_browse, theme_hikmah{{/str}} <span class="hk-btn__arrow" aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>
    {{/grid.0}}

    <section class="hk-section">
        <div class="hk-container">
            <header class="hk-section__head hk-section__head--center" data-hk-reveal>
                <span class="hk-eyebrow hk-eyebrow--plain">{{#str}}home2_steps_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk-section__title">{{#str}}home2_steps_title, theme_hikmah{{/str}}</h2>
            </header>
            <ol class="hk-journey hk-h2-steps list-unstyled m-0 p-0" data-hk-stagger>
                {{#steps}}<li class="hk-journey__step"><h3>{{title}}</h3><p>{{text}}</p></li>{{/steps}}
            </ol>
            <div class="text-center mt-5" data-hk-reveal>
                <a class="hk-btn" href="{{primaryurl}}">{{primarylabel}} <span class="hk-btn__arrow" aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>

    {{#teachers.0}}
    <section class="hk-section hk-section--tint">
        <div class="hk-container">
            <header class="hk-section__head" data-hk-reveal>
                <span class="hk-eyebrow">{{#str}}home2_teachers_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk-section__title">{{#str}}home2_teachers_title, theme_hikmah{{/str}}</h2>
                <p class="hk-section__lead">{{#str}}home2_teachers_lead, theme_hikmah{{/str}}</p>
            </header>
            <div class="hk-teachers" data-hk-stagger>
                {{#teachers}}
                    <div class="hk-teacher">
                        <span class="hk-teacher__initials" aria-hidden="true">{{initials}}</span>
                        <div><div class="hk-teacher__name">{{name}}</div><div class="hk-teacher__role">{{{courses}}}</div></div>
                    </div>
                {{/teachers}}
            </div>
            <p class="hk-h2-note" data-hk-reveal>{{#str}}home2_teachers_note, theme_hikmah{{/str}}</p>
        </div>
    </section>
    {{/teachers.0}}

    <section class="hk-section">
        <div class="hk-container">
            <header class="hk-section__head" data-hk-reveal>
                <span class="hk-eyebrow">{{#str}}modes_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk-section__title">{{#str}}home2_formats_title, theme_hikmah{{/str}}</h2>
            </header>
            <div class="hk-modes" data-hk-stagger>
                <a class="hk-mode" href="{{liveurl}}">
                    <div class="hk-mode__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="12" height="12" rx="3"/><path d="m15 10 6-3v10l-6-3"/></svg>
                    </div>
                    <h3 class="hk-mode__title">{{#str}}mode_live, theme_hikmah{{/str}}</h3>
                    <p class="hk-mode__text">{{#str}}home2_format_live, theme_hikmah{{/str}}</p>
                    <p class="hk-h2-bestfor">{{#str}}home2_format_live_best, theme_hikmah{{/str}}</p>
                    <span class="hk-mode__more">{{#str}}mode_browse, theme_hikmah{{/str}} <span aria-hidden="true">→</span></span>
                </a>
                <a class="hk-mode" href="{{selfpacedurl}}">
                    <div class="hk-mode__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    </div>
                    <h3 class="hk-mode__title">{{#str}}home2_format_recorded_title, theme_hikmah{{/str}}</h3>
                    <p class="hk-mode__text">{{#str}}home2_format_recorded, theme_hikmah{{/str}}</p>
                    <p class="hk-h2-bestfor">{{#str}}home2_format_recorded_best, theme_hikmah{{/str}}</p>
                    <span class="hk-mode__more">{{#str}}mode_browse, theme_hikmah{{/str}} <span aria-hidden="true">→</span></span>
                </a>
                <a class="hk-mode" href="{{hybridurl}}">
                    <div class="hk-mode__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5z"/><path d="m3 13 9 5 9-5"/></svg>
                    </div>
                    <h3 class="hk-mode__title">{{#str}}mode_hybrid, theme_hikmah{{/str}}</h3>
                    <p class="hk-mode__text">{{#str}}home2_format_hybrid, theme_hikmah{{/str}}</p>
                    <p class="hk-h2-bestfor">{{#str}}home2_format_hybrid_best, theme_hikmah{{/str}}</p>
                    <span class="hk-mode__more">{{#str}}mode_browse, theme_hikmah{{/str}} <span aria-hidden="true">→</span></span>
                </a>
            </div>
            <p class="hk-h2-note" data-hk-reveal>{{#str}}home2_formats_note, theme_hikmah{{/str}}</p>
        </div>
    </section>

    <section class="hk-section hk-section--tint">
        <div class="hk-container">
            <header class="hk-section__head hk-section__head--center" data-hk-reveal>
                <span class="hk-eyebrow hk-eyebrow--plain">{{#str}}home2_quotes_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk-section__title">{{#str}}home2_quotes_title, theme_hikmah{{/str}}</h2>
                <span class="hk-chip hk-chip--warning">{{#str}}home2_quotes_sample, theme_hikmah{{/str}}</span>
            </header>
            <div class="hk-h2-quotes" data-hk-stagger>
                {{#quotes}}
                    <figure class="hk-h2-quote m-0">
                        <blockquote class="m-0"><p>{{title}}</p></blockquote>
                        <figcaption>{{text}}</figcaption>
                    </figure>
                {{/quotes}}
            </div>
        </div>
    </section>

    <section class="hk-section">
        <div class="hk-container">
            <div class="hk-verify hk-h2-taster" data-hk-reveal>
                <div>
                    <span class="hk-eyebrow">{{#str}}home2_taster_eyebrow, theme_hikmah{{/str}}</span>
                    <h2 class="hk-section__title">{{#str}}home2_taster_title, theme_hikmah{{/str}}</h2>
                    <p class="hk-section__lead">{{#str}}home2_taster_lead, theme_hikmah{{/str}}</p>
                </div>
                <div class="hk-h2-actions">
                    <a class="hk-btn hk-btn--sun" href="{{freeurl}}">{{#str}}home2_taster_free, theme_hikmah{{/str}} <span class="hk-btn__arrow" aria-hidden="true">→</span></a>
                    <a class="hk-btn hk-btn--ghost" href="{{liveurl}}">{{#str}}home2_taster_live, theme_hikmah{{/str}}</a>
                    <p class="hk-verify__hint">{{#str}}home2_taster_micro, theme_hikmah{{/str}}</p>
                </div>
            </div>
        </div>
    </section>

    <section class="hk-section hk-section--tint">
        <div class="hk-container">
            <header class="hk-section__head hk-section__head--center" data-hk-reveal>
                <span class="hk-eyebrow hk-eyebrow--plain">{{#str}}faq_eyebrow, theme_hikmah{{/str}}</span>
                <h2 class="hk-section__title">{{#str}}home2_faq_title, theme_hikmah{{/str}}</h2>
            </header>
            <div class="hk-faq" data-hk-reveal>
                {{#faqs}}
                    <details class="hk-faq__item" data-hk-acc>
                        <summary>{{title}}<span class="hk-faq__icon" aria-hidden="true"></span></summary>
                        <div class="hk-faq__answer" data-hk-acc-body><div><p>{{text}}</p></div></div>
                    </details>
                {{/faqs}}
            </div>
            <div class="text-center mt-4" data-hk-reveal>
                <a class="hk-btn hk-btn--ghost" href="{{faqurl}}">{{#str}}faq_all, theme_hikmah{{/str}}</a>
            </div>
        </div>
    </section>

    <section class="hk-section hk-section--ink hk-quote">
        {{#quotemotif}}{{> theme_hikmah/motif }}{{/quotemotif}}
        <div class="hk-container">
            <figure class="hk-quote__inner m-0" data-hk-reveal>
                <blockquote class="m-0">
                    <p class="hk-quote__arabic" lang="ar" dir="rtl">وَقُل رَّبِّ زِدْنِي عِلْمًا</p>
                    <p class="hk-quote__text">{{#str}}home2_verse_text, theme_hikmah{{/str}}</p>
                </blockquote>
                <figcaption class="hk-quote__source">{{#str}}home2_verse_source, theme_hikmah{{/str}}</figcaption>
            </figure>
        </div>
    </section>

    <section class="hk-section">
        <div class="hk-container">
            <div class="hk-cta" data-hk-reveal="scale">
                <div>
                    <h2 class="hk-cta__title">{{#str}}home2_cta_title, theme_hikmah{{/str}}</h2>
                    <p class="hk-h2-cta__lead">{{#str}}home2_cta_lead, theme_hikmah{{/str}}</p>
                </div>
                <div class="hk-h2-actions">
                    <a class="hk-btn" href="{{primaryurl}}">{{primarylabel}} <span class="hk-btn__arrow" aria-hidden="true">→</span></a>
                    <a class="hk-btn hk-btn--ghost" href="{{catalogurl}}">{{#str}}home2_browse, theme_hikmah{{/str}}</a>
                </div>
            </div>
        </div>
    </section>

</div>
