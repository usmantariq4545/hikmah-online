{{!
    @template theme_hikmah/policy

    Public Privacy Policy, Terms of Use or Refund Policy page.

    Example context (json):
    {
        "homeurl": "#",
        "title": "Refund Policy",
        "lead": "When and how you can get a refund for a paid course.",
        "updated": "Last updated 27 November 2026",
        "content": "<h3>1. Before your payment is approved</h3><p>Text.</p>",
        "others": [{"url": "#", "name": "Privacy Policy"}, {"url": "#", "name": "Terms of Use"}]
    }
}}
<header class="hk-pagehead">
    {{#pagemotif}}{{> theme_hikmah/motif }}{{/pagemotif}}
    <div class="hk-container">
        <ol class="hk-crumbs" aria-label="{{#str}}breadcrumb, theme_hikmah{{/str}}">
            <li><a href="{{homeurl}}">{{#str}}nav_home, theme_hikmah{{/str}}</a></li>
            <li aria-current="page">{{title}}</li>
        </ol>
        <h1 class="hk-pagehead__title">{{title}}</h1>
        {{#lead}}<p class="hk-pagehead__lead">{{lead}}</p>{{/lead}}
    </div>
</header>

<section class="hk-section">
    <div class="hk-container">
        <article class="hk-policy">
            {{#updated}}<p class="hk-policy__updated">{{updated}}</p>{{/updated}}
            {{#content}}<div class="hk-policy__body">{{{content}}}</div>{{/content}}
            {{^content}}<p>{{#str}}policy_missing, theme_hikmah{{/str}}</p>{{/content}}
            <nav class="hk-policy__others" aria-label="{{#str}}policy_others, theme_hikmah{{/str}}">
                <span>{{#str}}policy_others, theme_hikmah{{/str}}</span>
                {{#others}}<a href="{{url}}">{{name}}</a>{{/others}}
            </nav>
        </article>
    </div>
</section>
