{
	email {$ACME_EMAIL}
	# Behind Cloudflare: take the visitor's address from CF-Connecting-IP, but only on requests that
	# come from Cloudflare's own ranges (https://www.cloudflare.com/ips/), so it cannot be spoofed.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_HOST} {
	encode zstd gzip
	request_body {
		max_size 100MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options SAMEORIGIN
		-Server
	}
	reverse_proxy nginx:80 {
		header_up X-Forwarded-Proto {scheme}
		# One address, the real visitor's, for Moodle's logs and login lockout.
		header_up X-Forwarded-For {client_ip}
	}
}
