# Hikmah Online — Nginx in front of PHP-FPM. Docroot is moodle/public; everything that is
# not a real file goes to the Moodle Router (r.php). TLS ends at Caddy on staging/prod.
server {
    listen 80 default_server;
    server_name _;

    root /var/www/moodle/public;
    index index.php;

    client_max_body_size 100M;
    server_tokens off;

    # The visitor's own address (Caddy, the only way in, sets X-Forwarded-For to it), so Moodle's logs and
    # the limits below see each visitor instead of Caddy.
    set_real_ip_from 172.16.0.0/12;
    real_ip_header X-Forwarded-For;
    limit_req_status 429;

    # Look Moodle (PHP-FPM) up through Docker's DNS on every request instead of once at start-up, so
    # restarting or recreating the moodle container (it gets a new address) never leaves Nginx
    # pointing at the old one (seen on the live site 2026-11-18: 502 until Nginx was restarted).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hk_fpm ${FPM_HOST}:9000;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    # woff2 and images are already compressed; compressing them again only costs CPU.
    gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain text/xml;

    # Remember open files and lookups so repeated static requests skip the disk.
    open_file_cache max=5000 inactive=60s;
    open_file_cache_valid 30s;
    open_file_cache_min_uses 2;
    open_file_cache_errors off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Source, test and package files Moodle lists as internal (its "public paths" security check).
    location ~ (/vendor/|/node_modules/|composer\.json|/readme|/README|readme\.txt|/upgrade\.txt|/UPGRADING\.md|db/install\.xml|/fixtures/|/behat/|phpunit\.xml|\.lock$|/environment\.xml|thirdpartylibs\.xml) {
        return 404;
    }

    # Dotfiles are never served (ACME challenges excepted).
    location ~ /\.(?!well-known) {
        return 404;
    }

    location / {
        try_files $uri @hkclean;
    }

    # Clean links (local_hikmahurls prints them): /course/<name>, /courses/<name>, the theme's short pages,
    # and any script without ".php" (/mod/quiz/view?id=9). Real files and every ".php" link keep working;
    # everything else still goes to the Moodle Router.
    location @hkclean {
        if (-f $document_root${uri}index.php) {
            rewrite ^ ${uri}index.php last;
        }
        if (-f $document_root$uri.php) {
            rewrite ^ $uri.php last;
        }
        # A folder asked for without its slash (/course): add it, as Nginx did before.
        if (-d $document_root$uri) {
            rewrite ^(.*[^/])$ $1/ permanent;
        }
        rewrite ^/course/([a-z0-9-]+)/?$ /local/hikmahurls/course.php?hkslug=$1&hkpage=view last;
        rewrite ^/courses/?$ /theme/hikmah/catalog.php last;
        rewrite ^/courses/([a-z0-9-]+)/?$ /local/hikmahurls/course.php?hkslug=$1&hkpage=info last;
        rewrite ^/(about|contact|faq|verify|classroom)/?$ /theme/hikmah/$1.php last;
        rewrite ^ /r.php last;
    }
    # moodledata, reachable only through Moodle's X-Accel-Redirect after an access check.
    location /dataroot/ {
        internal;
        alias /var/moodledata/;
    }

    location ~ ^/fpm-(status|ping)$ {
        allow 127.0.0.1;
        deny all;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass $hk_fpm;
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        set $path_info $fastcgi_path_info;
        try_files $fastcgi_script_name /r.php;

        include fastcgi_params;
        fastcgi_index index.php;
        fastcgi_param PATH_INFO $path_info;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param HTTPS $forwarded_https;
        # Moodle compares the request with its wwwroot: report the host and port the browser used,
        # not the port Nginx listens on inside the container.
        fastcgi_param SERVER_NAME $host;
        fastcgi_param SERVER_PORT $hk_port;
        limit_req zone=hklogin burst=30 nodelay;
        fastcgi_read_timeout 300s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_pass $hk_fpm;
    }
}

map $http_host $hk_port {
    default $server_port;
    "~:(?<hostport>[0-9]+)$" $hostport;
}

map $http_x_forwarded_proto $forwarded_https {
    default "";
    https on;
}
# Sign-in, sign-up, password reset and app-token requests: at most 20 a minute per visitor (POST only;
# bursts of 30 pass, so a class signing in from one network is not blocked). Answer: 429.
map "$request_method:$uri" $hk_login_key {
    "~^POST:/login/(index|signup|forgot_password|token)\.php$" $binary_remote_addr;
    default "";
}
limit_req_zone $hk_login_key zone=hklogin:10m rate=20r/m;

